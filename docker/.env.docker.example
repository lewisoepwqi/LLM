# Docker 部署变量示例（Linux GPU 服务器）
# 复制为 deploy/docker/.env，docker compose 会自动读取。
#
#   cp .env.docker.example .env
#
# 推荐自包含布局（与合同业务解耦）：
#   ~/app/LLM/
#     docker/   <- 本目录（compose 在这里跑）
#     models/   <- GGUF 放这里
# 此时 MODELS_DIR 用相对路径 ../models 即可（相对 compose 文件所在目录解析）。

# 宿主机模型目录，会被只读挂载到容器内 /models。
# 自包含布局用 ../models；放别处就写绝对路径，如 /home/ubuntu/app/LLM/models。
MODELS_DIR=../models

# 相对 /models 的模型文件路径（容器内路径 = /models/${MODEL_FILE}）。
MODEL_FILE=Qwen3.5-9B/Qwen_Qwen3.5-9B-Q5_K_M.gguf

# 暴露到宿主机的端口（容器内固定 8080）。
LLAMA_SERVER_PORT=8080

# 使用哪张 GPU。先单卡：0。第二张卡：1。
GPU_DEVICE_ID=0

# 上卡层数。9B 在 A4000(16GB) 可全量 offload，99 = 全部进显存。
N_GPU_LAYERS=99

# 上下文长度（总量）。开并行后按并行数均分到各槽，故 = 单槽上下文 × 并行数。
# 默认 16384 = 2 槽 × 8192/槽，配合 LLAMA_PARALLEL=2；显存吃紧可降到 8192（并配 LLAMA_PARALLEL=1）。
# 每槽 = CONTEXT_SIZE / LLAMA_PARALLEL；开视觉后每槽要同时装下图片(<=IMAGE_MAX_TOKENS)+正文
# +输出，别让每槽低于 8192——降总量时同步降 LLAMA_PARALLEL 即可，不必守住 16384 这个总量数字。
CONTEXT_SIZE=16384

# 并行解码槽数（连续批处理）。合同雷达「深度」检索逐份读正文可多路并发，需与后端
# READ_CONCURRENCY 配合（后端设几就并发几，别超过这里）。单卡 A4000 建议 2。
# 注意：单独把这个改成 1 并不省显存——KV 总量由 CONTEXT_SIZE 决定，不由槽数决定，
# 单独降这个只会把每槽（= CONTEXT_SIZE / LLAMA_PARALLEL）从 8192 拉到 16384。
# 真要降显存，把 CONTEXT_SIZE 和 LLAMA_PARALLEL 一起降（见上面 CONTEXT_SIZE 的注释）。
LLAMA_PARALLEL=2

# llama.cpp 镜像，钉死 build 号以便离线重打包时可复现。视觉要求 >= b9222。
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b9765

# 多模态投影器（视觉能力）。相对 /models 的路径，与主模型同目录。
# 文件在主模型同一个 HF 仓库：bartowski/Qwen_Qwen3.5-9B-GGUF，918165952 字节。
MMPROJ_FILE=Qwen3.5-9B/mmproj-Qwen_Qwen3.5-9B-f16.gguf


# 每张图的视觉 token 下限。llama.cpp 加载 Qwen-VL 时会警告模型自带默认值偏低、
# 建议显式设为 1024，否则定位类任务（印章/签字/表格截图这类小图）准确率会掉。
# 整页扫描件会被放大到接近 IMAGE_MAX_TOKENS，用不到这个下限。
IMAGE_MIN_TOKENS=1024
# 每张图的视觉 token 上限（Qwen-VL 动态分辨率约 784px≈1token）。
# 默认档 3072：配 CONTEXT_SIZE=16384 / LLAMA_PARALLEL=2（每槽 8192），
#   整页扫描件够用，且保留 2 路并发。
# 高精度档 6144：须同时把 LLAMA_PARALLEL 改成 1（每槽 16384），单图分辨率上限翻倍，
#   密集小字扫描件 OCR 更准，但并发归零，业务后端 READ_CONCURRENCY 须同步降到 1。
IMAGE_MAX_TOKENS=3072
